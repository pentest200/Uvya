# Copy this file to .env for local development. Never commit .env.
COMPOSE_PROJECT_NAME=uvya

# PostgreSQL
POSTGRES_DB=uvya
POSTGRES_USER=uvya
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=6379

# Authentication (use a high-entropy secret outside local development)
UVYA_REFRESH_TOKEN_PEPPER=change-me-local-refresh-token-pepper
UVYA_REFRESH_COOKIE_SECURE=false

# Kafka (single-node KRaft broker for local development)
KAFKA_EXTERNAL_PORT=9092

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application entry points
API_PORT=8080
WS_PORT=8081
WEB_PORT=3000
